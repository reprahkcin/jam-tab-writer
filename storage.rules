rules_version = '2';

// Take audio for the shared library. Same members as firestore.rules: the
// emails in Firestore's config/members (read here across services).
service firebase.storage {
  match /b/{bucket}/o {
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower()
           in firestore.get(/databases/(default)/documents/config/members).data.emails;
    }

    match /library/takes/{file} {
      allow read, delete: if isMember();
      allow create, update: if isMember()
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
  }
}
