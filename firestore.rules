rules_version = '2';

// The shared library (cloud mode) is open only to the addresses listed in the
// `emails` array of config/members. Edit that list in the Firebase console —
// Firestore > config > members: no redeploy needed. Addresses are lowercase.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower()
           in get(/databases/$(database)/documents/config/members).data.emails;
    }

    match /shared/library/{rest=**} {
      allow read, write: if isMember();
    }

    // The member list itself is edited only from the console.
    match /config/{doc} {
      allow read, write: if false;
    }
  }
}
